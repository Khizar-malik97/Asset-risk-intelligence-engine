# Copy this file to .env and adjust values for your environment.
# .env itself is git-ignored and must never be committed.

APP_NAME="AXERONIX Asset Intelligence Module"
ENVIRONMENT=development
DEBUG=true

# Required — there is no safe default for a secret. Generate a real random
# value for anything beyond local development, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-real-random-secret-at-least-16-chars

DATABASE_URL=sqlite:///./asset_intelligence.db

RISK_WEIGHTS_CONFIG_PATH=config/risk_weights.yaml
RISK_THRESHOLDS_CONFIG_PATH=config/risk_thresholds.yaml

API_HOST=0.0.0.0
API_PORT=8000

LOG_LEVEL=INFO
